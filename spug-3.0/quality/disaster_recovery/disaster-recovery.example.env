# =============================================================================
# Disaster Recovery Environment Template
# =============================================================================
# Copy this file to a secure location (e.g. ~/.dr.env or .dr.env in project root),
# fill in values, and set permissions: chmod 600 .dr.env
#
# This file contains NO real secrets. Replace all <PLACEHOLDER> values.
# =============================================================================

# ---- CRITICAL SAFETY SWITCH ----
# Must be "true" to allow restore/failure drills. Leave "false" for inspection-only.
ALLOW_RESTORE_DRILL=false

# ---- Target Database (for restore drills) ----
# MUST be a dedicated temp database. Name MUST contain one of: test, perf, drill.
# MUST NOT be "spug" (that is the dev/prod database).
DR_TARGET_DB=spug_drill

# ---- Target Container (for restore drills) ----
# MUST be a dedicated temp container. MUST NOT be "tdyw" or "tdyw-test".
DR_TARGET_CONTAINER=tdyw-drill

# ---- Target DB Container ----
# The MariaDB container that hosts DR_TARGET_DB.
# MUST NOT be "tdyw-db" or "tdyw-db-test" (they serve dev/prod data).
DR_TARGET_DB_CONTAINER=tdyw-db-drill

# ---- File Restore Target ----
# MUST be under a temp directory (e.g. /tmp/ or a dedicated /dr/ path).
# MUST NOT point to production storage paths.
DR_FILE_RESTORE_ROOT=/tmp/dr-restore-drill

# ---- Source Backup ----
# Borg archive name or backup_set directory name to restore from.
DR_BACKUP_ARCHIVE=tdyw-20260808-030000

# ---- Borg Configuration ----
BORG_ENV_FILE=/opt/docker/borgbackup/borg.env
# BORG_REPO and BORG_PASSPHRASE are read from BORG_ENV_FILE, not here.

# ---- MariaDB Restore Credentials ----
# A .cnf file (mode 0600) with DROP/CREATE/IMPORT privileges on DR_TARGET_DB.
RESTORE_CLIENT_CNF=/etc/tdyw-backup/tdyw_restore.cnf

# ---- Docker Compose File ----
# Path to the docker-compose.yml for the temp drill environment.
DR_COMPOSE_FILE=docker/docker-compose.drill.yml

# ---- Validation Settings ----
# Django settings module (for manage.py check)
DJANGO_SETTINGS_MODULE=spug.settings

# ---- Redis (for failure drill simulation) ----
# The Redis URL that the target app uses. Only used for mock simulation.
DR_REDIS_URL=redis://127.0.0.1:6379/1

# ---- Celery (for failure drill simulation) ----
DR_CELERY_BROKER_URL=redis://127.0.0.1:6379/2

# ---- kkFileView (for failure drill simulation) ----
DR_KKFILEVIEW_URL=http://tdyw-drill:8012

# ---- Application URL (for post-restore validation) ----
DR_APP_URL=http://localhost:28080

# ---- Test Credentials (for application validation) ----
# Create a dedicated test account in the drill database. Never use real credentials.
DR_TEST_USERNAME=dr_test_user
DR_TEST_PASSWORD=<REPLACE_WITH_DRILL_ONLY_PASSWORD>

# ---- Log Output ----
# Directory for drill logs. Will be redacted before writing.
DR_LOG_DIR=/tmp/dr-logs

# ---- Timeout Settings (seconds) ----
DR_APP_START_TIMEOUT=180
DR_DB_RESTORE_TIMEOUT=600
DR_FILE_RESTORE_TIMEOUT=900
