# Performance Testing Environment Configuration
# Copy to .env and fill in values before running tests

# === Required for any testing ===
# Base URL of the test target (must be test environment, not production)
BASE_URL=http://localhost

# Must be 'true' to allow any performance testing
ALLOW_PERFORMANCE_TEST=true

# === Required for write testing ===
# Must be 'true' to allow write load tests
ALLOW_WRITE_LOAD=false

# Database name - must be test database (e.g. test_spug, perf_spug)
# NOT 'spug' (dev) or any production database
DB_NAME=test_spug

# Target container name - must be test container (e.g. tdyw-test)
# NOT 'tdyw' (production)
TARGET_CONTAINER=tdyw-test

# === Test data configuration ===
# Prefix for all test data (for identification and cleanup)
PERF_DATA_PREFIX=PERF_

# Maximum records to create per test run
PERF_MAX_CREATE=50

# Maximum file size in KB
PERF_MAX_FILE_KB=1024

# Maximum number of files to upload per test run
PERF_MAX_FILE_COUNT=10

# === File test directory (must be dedicated temp, not production) ===
PERF_FILE_DIR=/tmp/perf_files

# === Test accounts (JSON array) ===
# Override default stress accounts if needed
# STRESS_ACCOUNTS=[{"username":"test1","password":"pass1"}]

# === Optional: Keep test data after run (default: keep) ===
# KEEP_TEST_DATA=1

# === Forbidden values (will cause test to refuse to run) ===
# DB_NAME=spug           # DEV database - FORBIDDEN
# TARGET_CONTAINER=tdyw  # Production container - FORBIDDEN
# BASE_URL=http://tdyw   # Production URL - FORBIDDEN
