# E2E Test Environment - Local Development
# Copy this file to .env and fill in real values
# NEVER commit the .env file with real credentials

# Base URL of the test system (MUST be dev/test, NOT production)
E2E_BASE_URL=http://localhost:8080

# Admin credentials (dedicated E2E test admin)
E2E_ADMIN_USERNAME=admin
E2E_ADMIN_PASSWORD=

# E2E test user (super user for general testing)
E2E_TEST_USERNAME=e2e_tester
E2E_TEST_PASSWORD=

# Regular user with limited permissions (create if available)
E2E_USER_USERNAME=
E2E_USER_PASSWORD=

# User with no document permissions
E2E_NO_DOC_USERNAME=
E2E_NO_DOC_PASSWORD=

# Tenant A user
E2E_TENANT_A_USERNAME=
E2E_TENANT_A_PASSWORD=

# Tenant B user
E2E_TENANT_B_USERNAME=
E2E_TENANT_B_PASSWORD=

# Playwright execution settings
E2E_RETRIES=1
E2E_WORKERS=1
