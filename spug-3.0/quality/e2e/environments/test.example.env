# E2E Test Environment - Test Server
# Copy this file to .env and fill in real values
# NEVER commit the .env file with real credentials

# Base URL of the test system (MUST be test environment, NOT production)
E2E_BASE_URL=http://test-server:8080

# Admin credentials
E2E_ADMIN_USERNAME=admin
E2E_ADMIN_PASSWORD=

# E2E test user
E2E_TEST_USERNAME=e2e_tester
E2E_TEST_PASSWORD=

# Playwright execution settings
E2E_RETRIES=2
E2E_WORKERS=1
