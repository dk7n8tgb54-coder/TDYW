# ================================================================================
# MariaDB 备份客户端配置模板（mariadb-dump 专用）
# --------------------------------------------------------------------------------
# 用途：统一备份入口通过此文件读取数据库账号和密码，避免从 docker/.env 取密码，
#       也避免在命令行使用 -u 或 -p 覆盖凭据。
#
# 部署步骤：
#   1. 复制本模板到 /etc/tdyw-backup/tdyw_backup.cnf（或 docker/config/secrets/）
#   2. 填入当前实际使用的数据库账号和密码
#   3. chmod 0600 该文件，属主为执行备份的系统用户
#   4. 备份脚本通过 --defaults-extra-file=<此文件> 读取凭据
#
# 统一 backup_set 脚本会把本文件复制到数据库容器内。user/password 仅以本文件为准；
# host/port 会覆盖为数据库容器内的 127.0.0.1:3306。
#
# 安全要求：
#   - 权限 0600，不得提交 Git
#   - 不通过 -pPASSWORD 传密码（进程参数可见）
# ================================================================================
[client]
host=tdyw-db
port=3306
user=root
password=REPLACE_WITH_DATABASE_PASSWORD
