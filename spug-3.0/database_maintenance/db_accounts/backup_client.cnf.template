# ================================================================================
# tdyw_backup 客户端配置模板（mariadb-dump / mariabackup 专用）
# --------------------------------------------------------------------------------
# 用途：供 backups/mariadump_backup.sh 与 mariabackup_backup.sh 使用，
#       替代 root + 从 docker/.env 读取 MYSQL_ROOT_PASSWORD + 命令行 -p 传密码。
#
# 部署步骤：
#   1. 复制本模板到 /etc/tdyw-backup/tdyw_backup.cnf（或 docker/config/secrets/）
#   2. 填入真实密码（与 init_db_accounts.sh 的 tdyw_backup secret 一致）
#   3. chmod 0600 该文件，属主为执行备份的系统用户
#   4. 备份脚本通过 --defaults-extra-file=<此文件> 读取凭据
#
# 备份脚本会在容器内执行 mariadb-dump/mariabackup，host 固定为 tdyw-db（容器名）。
# 若在宿主机直连，将 host 改为 127.0.0.1。
#
# 安全要求：
#   - 权限 0600，不得提交 Git
#   - 不通过 -pPASSWORD 传密码（进程参数可见）
# ================================================================================
[client]
host=tdyw-db
port=3306
user=tdyw_backup
password=REPLACE_WITH_TDYW_BACKUP_PASSWORD
