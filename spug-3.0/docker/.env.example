# ================================================================================
# 生产环境 .env 模板（第二阶段：非 root 化改造后）
# --------------------------------------------------------------------------------
# 使用方法：
#   cp docker/.env.example docker/.env
#   # 填入真实值（密码用 openssl rand -base64 24 生成）
#   chmod 0600 docker/.env
#
# 安全要求：
#   1. .env 文件不得提交 Git（已在 .gitignore 排除）
#   2. .env 文件权限必须 0600
#   3. 密码不得出现在命令行参数（-pPASSWORD）或 docker inspect
#   4. 推荐使用 _FILE 方式读取密码（见下方说明）
#   5. root 密码仅用于数据库初始化和 DBA 操作，不注入应用容器
# ================================================================================

# ==================== 数据库基础配置 ====================
# 业务数据库名称（与 MariaDB 初始化一致）
MYSQL_DATABASE=tdyw

# ==================== 数据库账号（第二阶段：非 root 化）====================
# 应用运行时账号（仅 DML 权限：SELECT/INSERT/UPDATE/DELETE）
# 不允许 DDL、账号管理、FILE、SUPER、GRANT OPTION
MYSQL_USER=tdyw_app

# --- 方式 A（推荐）：使用 secret 文件 ---
# 将密码写入 0600 权限的文件，通过 _FILE 环境变量指向
# 创建步骤：
#   mkdir -p docker/secrets
#   openssl rand -base64 24 > docker/secrets/tdyw_app_password
#   chmod 0600 docker/secrets/tdyw_app_password
MYSQL_PASSWORD_FILE=/run/secrets/tdyw_app_password

# Migration 账号密码文件（DDL + DML，仅发布时使用）
MYSQL_MIGRATE_PASSWORD_FILE=/run/secrets/tdyw_migrate_password

# DBA 日常管理账号密码文件（替代 root 用于日常 DBA 操作）
# DBA 手动登录时使用，不注入应用容器
TDYW_DBA_PASSWORD_FILE=/run/secrets/tdyw_dba_password

# --- 方式 B（过渡兼容）：明文环境变量（打印安全警告，不推荐生产使用）---
# 仅当 _FILE 未设置时生效
# MYSQL_PASSWORD=<tdyw_app_password>
# MYSQL_MIGRATE_PASSWORD=<tdyw_migrate_password>

# ==================== 数据库 root 密码（仅初始化+灾难恢复）====================
# root 密码仅用于：
#   1. 数据库初始化（MariaDB 首次启动）
#   2. 创建/修改应用账号（init_db_accounts.sh）
#   3. 灾难恢复（数据损坏、账号锁定、权限误配等紧急场景）
# 日常 DBA 操作请使用 tdyw_dba 账号（见上方 TDYW_DBA_PASSWORD_FILE）
# root 密码应封存在密码管理器（KeePass/1Password）中，另存一份离线应急副本
# 不注入应用容器（tdyw / tdyw-migrate service 不接收此变量）
MYSQL_ROOT_PASSWORD=<generate_with_openssl_rand_base64_24>

# ==================== Django 配置 ====================
# 生产环境必须修改为随机密钥
# 生成命令：python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=<generate_random_secret_key>
# 或使用 secret 文件：
# DJANGO_SECRET_KEY_FILE=/run/secrets/django_secret_key

DEBUG=False

# 允许访问的IP或域名
# 生产环境设置为具体值
ALLOWED_HOSTS=192.168.40.118,localhost,127.0.0.1,tdyw

# 允许的来源（Origin/Referer 校验）
ALLOWED_ORIGINS=https://192.168.40.118,http://localhost,http://127.0.0.1,http://tdyw

# ==================== Redis 配置（可选）====================
# Redis 默认无密码（容器内 127.0.0.1）
# 如需密码，推荐使用 _FILE 方式：
# REDIS_PASSWORD_FILE=/run/secrets/redis_password
# 或明文（不推荐）：
# REDIS_PASSWORD=<redis_password>

# ==================== kkFileView 配置 ====================
KKFILEVIEW_API_URL=/kkfileview
KKFILEVIEW_SERVER_URL=http://tdyw
