# ================================================================================
# 生产环境 .env 模板（第二阶段：非 root 化改造后）
# --------------------------------------------------------------------------------
# 使用方法：
#   cp docker/.env.example docker/.env
#   # 填入真实值（密码用 openssl rand -base64 24 生成）
#   chmod 0600 docker/.env
#
# 安全要求：
#   1. .env 文件不得提交 Git（已在 .gitignore 排除）
#   2. .env 文件权限必须 0600
#   3. 密码不得出现在命令行参数（-pPASSWORD）或 docker inspect
#   4. 推荐使用 _FILE 方式读取密码（见下方说明）
#   5. root 密码仅用于数据库初始化和 DBA 操作，不注入应用容器
# ================================================================================

# ==================== 数据库基础配置 ====================
# 业务数据库名称（与 MariaDB 初始化一致）
MYSQL_DATABASE=tdyw

# ==================== 数据库账号（非 root 最小权限）====================
# 应用运行时账号（DML + DDL 权限，无管理/系统/文件/授权权限）
#
# 全新部署：docker-compose.yml 的 tdyw-db 服务已配置 MYSQL_USER + MYSQL_PASSWORD
#           MySQL 镜像首次初始化时自动创建用户并授权，无需手动操作
# 已有数据库：init_tdyw_account.sql 未实施（2026-10-31 审计）；生产现状沿用 root
#            （.env 显式 MYSQL_USER=root），未来非 root 化须先建库内账号再改此值
MYSQL_USER=tdyw
MYSQL_PASSWORD=<generate_with_openssl_rand_base64_24>

# ==================== 数据库 root 密码（仅初始化+灾难恢复）====================
# root 密码仅用于：
#   1. 数据库初始化（MariaDB 首次启动）
#   2. 创建/修改应用账号（init_db_accounts.sh）
#   3. 灾难恢复（数据损坏、账号锁定、权限误配等紧急场景）
# 日常 DBA 操作请使用 tdyw_dba 账号（见上方 TDYW_DBA_PASSWORD_FILE）
# root 密码应封存在密码管理器（KeePass/1Password）中，另存一份离线应急副本
# 不注入应用容器（tdyw / tdyw-migrate service 不接收此变量）
MYSQL_ROOT_PASSWORD=<generate_with_openssl_rand_base64_24>

# ==================== Django 配置 ====================
# 生产环境必须修改为随机密钥
# 生成命令：python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=<generate_random_secret_key>
# 或使用 secret 文件：
# DJANGO_SECRET_KEY_FILE=/run/secrets/django_secret_key

DEBUG=False

# 允许访问的IP或域名
# 生产环境设置为具体值
ALLOWED_HOSTS=192.168.40.118,localhost,127.0.0.1,tdyw

# 允许的来源（Origin/Referer 校验）
ALLOWED_ORIGINS=https://192.168.40.118,http://localhost,http://127.0.0.1,http://tdyw

# ==================== Redis 配置 ====================
# Redis 仅监听 127.0.0.1 不对外暴露，密码防容器内未授权访问
REDIS_PASSWORD=<generate_with_openssl_rand_base64_24>

# ==================== kkFileView 配置 ====================
KKFILEVIEW_API_URL=/kkfileview
KKFILEVIEW_SERVER_URL=http://tdyw
# Excel 台账 PDF 生成引擎：chromium（缺省，浏览器打印引擎，需镜像内已装 chromium 与中文字体）
# 可选 libreoffice（经 LibreOffice 转换）或 auto（chromium 可用时优先）
EXCEL_PDF_ENGINE=chromium
# Docker sidecar 平台健康探活
HEALTH_PROBE_URL=http://tdyw/api/document/health/
HEALTH_PROBE_INTERVAL=60

# ==================== ONLYOFFICE Docs 在线编辑（制度管理） ====================
# 与 docker-compose.yml 中 tdyw / onlyoffice / onlyoffice-db / onlyoffice-mq
# 四个服务同源的一组变量。留空 ONLYOFFICE_JWT_SECRET 时应用侧自动降级为
# "下载→本机编辑→上传保存"，不影响其余功能；启用在线编辑必须配齐以下全部键
# （启用步骤见 onlyoffice-main/README.md）。密码独立生成、不得复用 dev 开发
# 凭据（oomain* / oo10*）、不得提交 Git。
# 未配置这些键时其他服务的 compose 操作不受任何影响（compose 占位为空缺省）；
# OO 栈自身在启动层拒绝空凭据（postgres 拒绝空密码初始化、入口包装脚本校验
# DB/MQ 账号非空），不会静默以弱凭据运行。
ONLYOFFICE_DOCS_URL=/onlyoffice
# JWT 双向签名密钥（tdyw 与 onlyoffice 服务共用）
# 生成命令：openssl rand -base64 32
ONLYOFFICE_JWT_SECRET=<generate_with_openssl_rand_base64_32>
# DS 回源本应用的基址（Compose 网络 tdyw 网络别名）
ONLYOFFICE_PUBLIC_BASE_URL=http://tdyw
# 回调文件下载主机名白名单（PUBLIC_BASE_URL 的主机名 tdyw 由后端自动并入）
ONLYOFFICE_ALLOWED_URL_HOSTS=tdyw-onlyoffice,tdyw
# 编辑器 token 有效期（秒）
ONLYOFFICE_EDITOR_TOKEN_TTL_SECONDS=3600
# ONLYOFFICE 10.0 专用外部 PostgreSQL 密码（onlyoffice-db 与入口包装脚本共用）
ONLYOFFICE_DB_PASSWORD=<generate_with_openssl_rand_base64_24>
# ONLYOFFICE 10.0 专用外部 RabbitMQ 账号（guest 仅限 localhost 登录，必须独立账号；
# 两者将拼入 AMQP URI，密码避免使用 @ : / # 等 URI 保留字符）
ONLYOFFICE_MQ_USER=onlyoffice
ONLYOFFICE_MQ_PASSWORD=<generate_with_openssl_rand_base64_24>

# ==================== 延迟上线模块（可选） ====================
# 逗号分隔的暂不上线模块名（app 名），容器启动时跳过其数据库迁移且不注册其 API；
# 不设置或留空 = 全部模块正常上线。示例：RELEASE_PENDING_APPS=equipment_lifecycle
#RELEASE_PENDING_APPS=
