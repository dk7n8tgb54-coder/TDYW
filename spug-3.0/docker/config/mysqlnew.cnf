# ================================================================================
# MySQL/MariaDB 数据库配置文件
# ================================================================================
# 说明：此配置已针对数据库迁移场景优化
# 版本：MariaDB 10.8.2
# 适用环境：内网部署，支持大表迁移

[mysqld]

# ================================================================================
# 字符集和排序规则
# ================================================================================
# 设置服务器默认字符集为 UTF-8（使用 4 字节表示，支持中文和 Emoji）
character-set-server=utf8mb4
# 排序规则：不区分大小写，性能和兼容性平衡
collation-server=utf8mb4_unicode_ci

# ================================================================================
# 二进制日志 (Binlog) 配置 - 用于数据恢复、主从复制和审计
# ================================================================================
# 启用因二进制日志，记录所有数据修改操作
log-bin=mysql-bin
# Binlog 格式：ROW 模式，数据恢复更可靠
binlog-format=ROW
# 数据库服务器唯一 ID（主从复制场景需要）
server-id=1
# 保留最近 7 天的二进制日志（根据数据量调整）
# 注意：expire_logs_days 在 MariaDB 10.8+ 已弃用，使用 binlog_expire_logs_seconds
binlog_expire_logs_seconds=604800
# 每次事务提交后同步 binlog 到磁盘（与 innodb_flush_log_at_trx_commit=1 配合实现断电零丢失）
# 发布阻断项：必须为 1
sync_binlog=1

# ================================================================================
# 性能优化 - 连接数
# ================================================================================
# 最大并发连接数：32G 服务器上调到 500
# 原 300 适配 8G 服务器；32G 服务器 buffer_pool 充足，可支撑更多并发连接
max_connections=500

# 连接超时设置（与 Django CONN_MAX_AGE=300 匹配）
# wait_timeout: 服务器关闭非交互连接前的等待时间
# interactive_timeout: 交互式连接超时时间
wait_timeout=300
interactive_timeout=300

# 最大连接错误数：防止暴力破解，超过后锁定IP
max_connect_errors=1000

# ================================================================================
# 可选优化参数（资料库文件多、高并发场景优化）
# ================================================================================
# 表缓存：资料库表数量多时提升性能
table_open_cache=4000

# 线程缓存：高并发时减少线程创建开销
thread_cache_size=32

# 最大允许数据包：大文件上传时避免"packet too large"错误
max_allowed_packet=256M

# ================================================================================
# 性能优化 - InnoDB 缓冲池
# 关键参数：影响数据库性能和内存使用
# 32G 物理服务器内存分配（总计 32G，扣除系统 2G，三个容器分 14G，留 16G 余量）：
#   - 数据库容器 limit 8G → buffer_pool 6G（75%，剩余 2G 给连接/日志/OS）
#   - 主应用容器 limit 4G
#   - kkFileView 容器 limit 2G
# ================================================================================
# 【优化 2026-08-13】32G 服务器：从 2G 上调到 6G
# 原 2G 适配 8G 服务器（3G 容器）；32G 服务器下 buffer_pool 6G 显著提升缓存命中率
innodb_buffer_pool_size=6G

# 事务日志大小：增加可减少 I/O，但恢复时间增加
# 【优化 2026-04-01】从 64M 提升到 128M（批量上传优化）
innodb_log_file_size=128M

# 事务日志刷新策略（关键持久性参数，发布阻断项）
# 1：每次提交都刷新到磁盘，最安全，断电不丢已提交事务（生产强制值）
# 2：每次提交写入日志，由操作系统决定何时刷新（性能更好但断电可能丢 1 秒数据，非生产允许值）
# 注意：当前日写入量低（约 200 条/天），强刷盘对业务性能影响极小，
#       不得为微小吞吐提升保留数据丢失窗口。
innodb_flush_log_at_trx_commit=1

# 双写缓冲：防止部分页写损坏，生产强制开启
# 显式写入配置，避免自定义镜像默认值变化导致意外关闭
innodb_doublewrite=ON

# 锁等待超时时间：已从 120 秒优化到 300 秒，避免大表迁移时锁超时
innodb_lock_wait_timeout=300

# 日志缓冲区大小：减少磁盘 I/O
innodb_log_buffer_size=64M

# 独立表空间：每个表单独一个文件，删除表时只删除对应文件
innodb_file_per_table=1

# 【优化 2026-04-01】添加 I/O 线程优化（批量上传性能提升）
innodb_read_io_threads=8
innodb_write_io_threads=8

# 自适应刷新：根据脏页数量自动调整刷新频率
innodb_adaptive_flushing=1

# 【防损坏 2026-08-04】降低脏页比例上限（默认 90% -> 60%）
# 脏页更早被后台线程刷到磁盘，容器停止时残余脏页更少，刷盘更快
innodb_max_dirty_pages_pct=60
innodb_max_dirty_pages_pct_lwm=10

# 【防损坏 2026-08-04】告知 InnoDB 磁盘性能（机械盘 200 IOPS）
# 让后台刷盘节奏匹配实际 I/O 能力，避免积压
innodb_io_capacity=200
innodb_io_capacity_max=600

# ================================================================================
# 慢查询日志 - 用于性能分析和 SQL 优化
# ================================================================================
# 启用慢查询日志
slow_query_log=1
# 慢查询日志文件路径
slow_query_log_file=/var/log/mysql/slow
# 慢查询阈值：执行超过 1 秒的 SQL 会被记录
long_query_time=1

# ================================================================================
# SQL 模式配置
# ================================================================================
# STRICT_TRANS_TABLES：事务表严格模式，禁止无效数据
# NO_ZERO_IN_DATE/NO_ZERO_DATE：禁止日期中的月份或日为 0
# ERROR_FOR_DIVISION_BY_ZERO：禁止除数为 0
# NO_ENGINE_SUBSTITUTION：未指定存储引擎时报错
sql_mode=STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION

# ================================================================================
# 客户端配置
# ================================================================================
[client]
default-character-set=utf8mb4

[mysqldump]
max_allowed_packet=256M
