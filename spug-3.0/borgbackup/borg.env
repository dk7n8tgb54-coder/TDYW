BORG_REPO=/data/borg_repo
BORG_PASSPHRASE=Dt6299093

BORG_REMOTE_REPO=tdywuser@172.16.40.2:/data/tdyw_backup
BORG_REMOTE_PASSPHRASE=Dt6299093
PUSH_REMOTE=YES
BORG_RSH="ssh -o BatchMode=yes -o StrictHostKeyChecking=accept-new"

# ---- 容器与卷名（生产/开发各不相同，在此覆盖） ----
APP_CONTAINER=tdyw
DB_CONTAINER=tdyw-db
DOCUMENTS_VOLUME=docker_tdyw-documents
MEDIA_VOLUME=docker_tdyw-media
MYSQL_DATA_VOLUME=docker_tdyw-mysql-data
# ---- 数据库 ----
DB_NAME=tdyw
BACKUP_CLIENT_CNF=/opt/docker/borgbackup/tdyw_backup.cnf

# ---- 容器内路径 ----
DOCUMENTS_PATH=/data/spug/spug_api/storage/documents
MEDIA_PATH=/data/spug/spug_api/media

# ---- 备份参数 ----
BORG_COMPRESSION=zstd,3
APP_STOP_TIMEOUT=900
HEALTH_TIMEOUT=180
MIN_FREE_PERCENT=15