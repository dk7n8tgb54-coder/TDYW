# TDYW 远程 borg 仓库自检配置模板
# 复制为 borg_remote_check.env（默认路径 /opt/borgbackup/borg_remote_check.env），
# 填写真实值后 chmod 600。此文件含 passphrase，禁止提交 Git。
#
# 仓库路径：远程机上的本地路径（不是 ssh: 形式）
BORG_REPO=/data/tdyw_backup
# 远程仓库 passphrase（与备份机 borg.env 中的 BORG_REMOTE_PASSPHRASE 相同）
BORG_PASSPHRASE=REPLACE_WITH_REMOTE_REPO_PASSPHRASE
