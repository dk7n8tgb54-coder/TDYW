{
  "info": {
    "name": "文档管理分表改造测试集合",
    "description": "测试私有/公共空间隔离、权限校验、安全防护",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000/api",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "your_admin_token_here",
      "type": "string"
    },
    {
      "key": "user1Token",
      "value": "your_user1_token_here",
      "type": "string"
    },
    {
      "key": "user2Token",
      "value": "your_user2_token_here",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. 私有空间 - 创建文件夹",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Token",
            "value": "{{user1Token}}"
          },
          {
            "key": "X-Forwarded-For",
            "value": "127.0.0.1"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/document/folder/",
          "host": ["{{baseUrl}}"],
          "path": ["document", "folder", ""]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"私有文件夹1\",\n  \"parent_id\": null,\n  \"is_public\": false\n}"
        }
      }
    },
    {
      "name": "2. 公共空间 - 创建文件夹",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Token",
            "value": "{{user1Token}}"
          },
          {
            "key": "X-Forwarded-For",
            "value": "127.0.0.1"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/document/folder/",
          "host": ["{{baseUrl}}"],
          "path": ["document", "folder", ""]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"公共文件夹1\",\n  \"parent_id\": null,\n  \"is_public\": true\n}"
        }
      }
    },
    {
      "name": "3. 私有空间 - 获取文件夹列表",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Token",
            "value": "{{user1Token}}"
          },
          {
            "key": "X-Forwarded-For",
            "value": "127.0.0.1"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/document/folder/?is_public=false",
          "host": ["{{baseUrl}}"],
          "path": ["document", "folder", ""],
          "query": [
            {
              "key": "is_public",
              "value": "false"
            }
          ]
        }
      }
    },
    {
      "name": "4. 公共空间 - 获取文件夹列表",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Token",
            "value": "{{user1Token}}"
          },
          {
            "key": "X-Forwarded-For",
            "value": "127.0.0.1"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/document/folder/?is_public=true",
          "host": ["{{baseUrl}}"],
          "path": ["document", "folder", ""],
          "query": [
            {
              "key": "is_public",
              "value": "true"
            }
          ]
        }
      }
    },
    {
      "name": "5. 私有空间 - 上传文件",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Token",
            "value": "{{user1Token}}"
          },
          {
            "key": "X-Forwarded-For",
            "value": "127.0.0.1"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/document/upload/",
          "host": ["{{baseUrl}}"],
          "path": ["document", "upload", ""]
        },
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": "/path/to/test.txt"
            },
            {
              "key": "folder_id",
              "value": "",
              "type": "text"
            },
            {
              "key": "is_public",
              "value": "false",
              "type": "text"
            }
          ]
        }
      }
    },
    {
      "name": "6. 公共空间 - 上传文件",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Token",
            "value": "{{user1Token}}"
          },
          {
            "key": "X-Forwarded-For",
            "value": "127.0.0.1"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/document/upload/",
          "host": ["{{baseUrl}}"],
          "path": ["document", "upload", ""]
        },
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": "/path/to/test.txt"
            },
            {
              "key": "folder_id",
              "value": "",
              "type": "text"
            },
            {
              "key": "is_public",
              "value": "true",
              "type": "text"
            }
          ]
        }
      }
    },
    {
      "name": "7. 私有空间 - 秒传检查",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Token",
            "value": "{{user1Token}}"
          },
          {
            "key": "X-Forwarded-For",
            "value": "127.0.0.1"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/document/check_file/",
          "host": ["{{baseUrl}}"],
          "path": ["document", "check_file", ""]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"file_hash\": \"a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4\",\n  \"file_size\": 1024,\n  \"is_public\": false\n}"
        }
      }
    },
    {
      "name": "8. 公共空间 - 秒传检查",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Token",
            "value": "{{user1Token}}"
          },
          {
            "key": "X-Forwarded-For",
            "value": "127.0.0.1"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/document/check_file/",
          "host": ["{{baseUrl}}"],
          "path": ["document", "check_file", ""]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"file_hash\": \"a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4\",\n  \"file_size\": 1024,\n  \"is_public\": true\n}"
        }
      }
    },
    {
      "name": "9. 空间隔离测试 - user2查看user1私有文件",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Token",
            "value": "{{user2Token}}"
          },
          {
            "key": "X-Forwarded-For",
            "value": "127.0.0.1"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/document/folder/?is_public=false",
          "host": ["{{baseUrl}}"],
          "path": ["document", "folder", ""],
          "query": [
            {
              "key": "is_public",
              "value": "false"
            }
          ]
        },
        "description": "user2不应该看到user1的私有文件夹"
      }
    },
    {
      "name": "10. 权限测试 - user2删除user1公共文件",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "X-Token",
            "value": "{{user2Token}}"
          },
          {
            "key": "X-Forwarded-For",
            "value": "127.0.0.1"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/document/folder/?id=1&is_public=true",
          "host": ["{{baseUrl}}"],
          "path": ["document", "folder", ""],
          "query": [
            {
              "key": "id",
              "value": "1",
              "description": "需要先创建一个公共文件夹获取ID"
            },
            {
              "key": "is_public",
              "value": "true"
            }
          ]
        },
        "description": "user2删除user1的公共文件夹应该失败"
      }
    },
    {
      "name": "11. 路径遍历攻击测试",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Token",
            "value": "{{user1Token}}"
          },
          {
            "key": "X-Forwarded-For",
            "value": "127.0.0.1"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/document/folder/",
          "host": ["{{baseUrl}}"],
          "path": ["document", "folder", ""]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"../../../etc/passwd\",\n  \"parent_id\": null,\n  \"is_public\": false\n}"
        },
        "description": "应该拒绝路径遍历攻击"
      }
    },
    {
      "name": "12. XSS攻击测试",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Token",
            "value": "{{user1Token}}"
          },
          {
            "key": "X-Forwarded-For",
            "value": "127.0.0.1"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/document/folder/",
          "host": ["{{baseUrl}}"],
          "path": ["document", "folder", ""]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"test<script>alert(1)</script>\",\n  \"parent_id\": null,\n  \"is_public\": false\n}"
        },
        "description": "应该拒绝XSS攻击"
      }
    },
    {
      "name": "13. 私有空间 - 磁盘使用率",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Token",
            "value": "{{user1Token}}"
          },
          {
            "key": "X-Forwarded-For",
            "value": "127.0.0.1"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/document/disk_usage/?is_public=false",
          "host": ["{{baseUrl}}"],
          "path": ["document", "disk_usage", ""],
          "query": [
            {
              "key": "is_public",
              "value": "false"
            }
          ]
        }
      }
    },
    {
      "name": "14. 公共空间 - 磁盘使用率",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Token",
            "value": "{{user1Token}}"
          },
          {
            "key": "X-Forwarded-For",
            "value": "127.0.0.1"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/document/disk_usage/?is_public=true",
          "host": ["{{baseUrl}}"],
          "path": ["document", "disk_usage", ""],
          "query": [
            {
              "key": "is_public",
              "value": "true"
            }
          ]
        }
      }
    },
    {
      "name": "15. 管理员 - 删除公共文件",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "X-Token",
            "value": "{{adminToken}}"
          },
          {
            "key": "X-Forwarded-For",
            "value": "127.0.0.1"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/document/folder/?id=1&is_public=true",
          "host": ["{{baseUrl}}"],
          "path": ["document", "folder", ""],
          "query": [
            {
              "key": "id",
              "value": "1"
            },
            {
              "key": "is_public",
              "value": "true"
            }
          ]
        },
        "description": "管理员可以删除任何公共文件夹"
      }
    },
    {
      "name": "16. 文件夹树形结构",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Token",
            "value": "{{user1Token}}"
          },
          {
            "key": "X-Forwarded-For",
            "value": "127.0.0.1"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/document/folder/?all=true&is_public=false",
          "host": ["{{baseUrl}}"],
          "path": ["document", "folder", ""],
          "query": [
            {
              "key": "all",
              "value": "true"
            },
            {
              "key": "is_public",
              "value": "false"
            }
          ]
        }
      }
    },
    {
      "name": "17. 边界测试 - 255字符文件名",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Token",
            "value": "{{user1Token}}"
          },
          {
            "key": "X-Forwarded-For",
            "value": "127.0.0.1"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/document/folder/",
          "host": ["{{baseUrl}}"],
          "path": ["document", "folder", ""]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\n  \"parent_id\": null,\n  \"is_public\": false\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "255字符文件名应该成功"
      }
    },
    {
      "name": "18. 边界测试 - 256字符文件名",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Token",
            "value": "{{user1Token}}"
          },
          {
            "key": "X-Forwarded-For",
            "value": "127.0.0.1"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/document/folder/",
          "host": ["{{baseUrl}}"],
          "path": ["document", "folder", ""]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\n  \"parent_id\": null,\n  \"is_public\": false\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "256字符文件名应该失败"
      }
    }
  ]
}
