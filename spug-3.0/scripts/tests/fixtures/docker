#!/bin/sh
# Minimal read-only Docker fixture used only by backup_set_create.sh dry-run tests.
set -eu

case "${1:-}" in
    inspect)
        format="${3:-}"
        case "${format}" in
            *State.Running*) printf 'true\n' ;;
            *Config.Image*)
                case "${4:-}" in
                    tdyw-test) printf 'tdyw:test\n' ;;
                    tdyw-db-test) printf 'mysql:test\n' ;;
                    *) exit 1 ;;
                esac
                ;;
            *) exit 1 ;;
        esac
        ;;
    exec)
        if [ "${2:-}" = "tdyw-db-test" ] && [ "${3:-}" = "sh" ]; then
            case "${5:-}" in
                *MYSQL_DATABASE*) printf 'tdyw_test' ;;
                *mariadb-dump*)
                    case "${5:-}" in *'>/dev/null'*) ;; *) printf '/usr/bin/mariadb-dump\n' ;; esac
                    ;;
                *mariadb*)
                    case "${5:-}" in *'>/dev/null'*) ;; *) printf '/usr/bin/mariadb\n' ;; esac
                    ;;
            esac
        elif [ "${2:-}" = "tdyw-db-test" ] && [ "${3:-}" = "/usr/bin/mariadb" ]; then
            case "$*" in
                *CURRENT_USER*) printf 'root@localhost\n' ;;
                *django_migrations*) printf '1\n' ;;
            esac
        elif [ "${3:-}" = "supervisorctl" ] && [ "${4:-}" = "status" ]; then
            printf 'spug-api RUNNING pid 10, uptime 0:01:00\n'
            printf 'spug-celery RUNNING pid 11, uptime 0:01:00\n'
        fi
        ;;
    cp)
        # The fixture validates control flow only; it never copies the secret.
        ;;
    *)
        printf 'fixture refuses mutating docker command: %s\n' "${1:-}" >&2
        exit 90
        ;;
esac
