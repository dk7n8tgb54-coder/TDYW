#!/bin/bash
# Git 预提交钩子 - 代码质量检查

echo "Running pre-commit checks..."
echo ""

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
PROJECT_DIR="$ROOT_DIR/spug-3.0"

FRONTEND_FILES=$(git diff --cached --name-only | grep "spug_web/src/.*\.js" || true)
if [ -n "$FRONTEND_FILES" ]; then
    echo -e "${YELLOW}[1/3] Checking frontend code (ESLint)...${NC}"
    cd "$PROJECT_DIR/spug_web"
    if command -v npx &> /dev/null; then
        # 忽略已知有ESLint解析问题的文件
        npx eslint src/ --ext .js,.jsx --quiet --ignore-pattern "**/DataViewTable.js" --ignore-pattern "**/FileGrid.js"
        if [ $? -ne 0 ]; then
            echo -e "${RED}Frontend linting failed.${NC}"
            exit 1
        fi
        echo -e "${GREEN}Frontend checks passed!${NC}"
    fi
fi

BACKEND_FILES=$(git diff --cached --name-only | grep "spug_api/.*\.py" || true)
if [ -n "$BACKEND_FILES" ]; then
    echo -e "${YELLOW}[2/3] Checking backend code (Flake8)...${NC}"
    cd "$PROJECT_DIR/spug_api"
    if command -v flake8 &> /dev/null; then
        flake8 apps/ libs/ consumer/ --count
        if [ $? -ne 0 ]; then
            echo -e "${RED}Backend linting failed.${NC}"
            exit 1
        fi
        echo -e "${GREEN}Backend checks passed!${NC}"
    fi
fi

echo -e "${YELLOW}[3/3] Running code quality check...${NC}"
cd "$PROJECT_DIR"
if [ -f "scripts/code_quality_check.py" ]; then
    python scripts/code_quality_check.py
    if [ $? -ne 0 ]; then
        echo -e "${RED}Code quality check failed.${NC}"
        exit 1
    fi
    echo -e "${GREEN}Code quality check passed!${NC}"
fi

echo ""
echo -e "${GREEN}All checks passed!${NC}"
