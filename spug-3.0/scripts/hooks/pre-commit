#!/bin/sh
# Git Pre-commit Hook
# 代码门禁：提交前自动检查代码质量

# 获取项目根目录（使用 git rev-parse 确保路径正确）
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_ROOT="$(git rev-parse --show-toplevel)/spug-3.0"

echo "=========================================="
echo "       代码门禁 - 提交前检查"
echo "=========================================="
echo ""

# 获取本次提交修改的文件（只检查 spug_api 和 spug_web 目录）
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^spug-3\.0/(spug_api|spug_web)/')

# 检查是否有 Python 或 JS 文件需要检查
HAS_CODE_FILES=0
for file in $STAGED_FILES; do
    if echo "$file" | grep -qE '\.(py|js|jsx)$'; then
        HAS_CODE_FILES=1
        break
    fi
done

if [ $HAS_CODE_FILES -eq 0 ]; then
    echo "OK: No code files in spug_api/spug_web to check"
    exit 0
fi

# 运行代码质量检查
echo "正在运行代码质量检查..."
echo ""

python3 "$PROJECT_ROOT/scripts/code_quality_check.py"
EXIT_CODE=$?

if [ $EXIT_CODE -ne 0 ]; then
    echo ""
    echo "=========================================="
    echo "  ❌ 代码门禁检查失败"
    echo "=========================================="
    echo ""
    echo "请修复上述问题后再提交。"
    echo "如需强制提交，使用: git commit --no-verify"
    echo ""
    exit 1
fi

echo ""
echo "=========================================="
echo "  ✓ 代码门禁检查通过"
echo "=========================================="
echo ""

exit 0
